rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // SECURITY HELPER FUNCTIONS
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAccountActive() {
      return isAuthenticated() && getUserData().status == 'active';
    }

    function isSuperAdmin() {
      return isAccountActive() && getUserData().role == 'Super Admin';
    }

    function isAdmin() {
      return isAccountActive() && (getUserData().role in ['Super Admin', 'Admin']);
    }

    function isStaff() {
      return isAccountActive() && (
        getUserData().role in ['Super Admin', 'Admin', 'Operations Manager', 'Merchandiser', 'Production Staff', 'QC Staff']
      );
    }

    function isBuyer() {
      return isAccountActive() && getUserData().role == 'Buyer';
    }

    function belongsToBuyerOrg(buyerOrgId) {
      return isBuyer() && getUserData().buyerOrganizationId == buyerOrgId;
    }

    // =========================================================================
    // DEFAULT: DENY ALL
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // USERS COLLECTION
    // Privileged fields (role, buyerOrganizationId, status) are strictly
    // non-writable by standard client accounts.
    // =========================================================================
    match /users/{userId} {
      allow read: if isAccountActive() && (request.auth.uid == userId || isStaff());
      
      // Self profile edit: Only displayName and photoURL can be updated
      allow update: if isAccountActive() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'buyerOrganizationId', 'status', 'permissions']);

      // Administrative user management
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // BUYER ORGANIZATIONS
    // Tenant boundaries for all buyer accounts.
    // =========================================================================
    match /buyerOrganizations/{orgId} {
      allow read: if isStaff() || belongsToBuyerOrg(orgId);
      allow write: if isStaff();
    }

    // =========================================================================
    // ORDERS COLLECTION
    // Enforces strict tenant isolation per buyerOrganizationId.
    // =========================================================================
    match /orders/{orderId} {
      allow read: if isStaff() || belongsToBuyerOrg(resource.data.buyerOrganizationId);
      allow write: if isStaff();

      match /productionStages/{stageId} {
        allow read: if isStaff() || belongsToBuyerOrg(get(/databases/$(database)/documents/orders/$(orderId)).data.buyerOrganizationId);
        allow write: if isStaff();
      }
    }

    // =========================================================================
    // PRODUCTION UPDATES
    // Buyers can only read published updates for orders belonging to their org.
    // =========================================================================
    match /productionUpdates/{updateId} {
      allow read: if isStaff() || (
        isBuyer() && 
        resource.data.status == 'published' &&
        belongsToBuyerOrg(resource.data.buyerOrganizationId)
      );
      allow write: if isStaff();
    }

    // =========================================================================
    // PRODUCTION PHOTOS
    // =========================================================================
    match /productionPhotos/{photoId} {
      allow read: if isStaff() || (
        isBuyer() && 
        belongsToBuyerOrg(get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.buyerOrganizationId)
      );
      allow write: if isStaff();
    }

    // =========================================================================
    // SAMPLES & COMMENTS
    // =========================================================================
    match /samples/{sampleId} {
      allow read: if isStaff() || belongsToBuyerOrg(resource.data.buyerOrganizationId);
      allow create, delete: if isStaff();
      allow update: if isStaff() || (
        isBuyer() &&
        belongsToBuyerOrg(resource.data.buyerOrganizationId) &&
        resource.data.status == 'submitted' &&
        request.resource.data.status in ['approved', 'changes_requested', 'rejected']
      );
    }

    // =========================================================================
    // DOCUMENTS COLLECTION
    // Enforces buyer-visibility flag and buyer organization match.
    // =========================================================================
    match /documents/{docId} {
      allow read: if isStaff() || (
        isBuyer() &&
        resource.data.visibility == 'buyer' &&
        belongsToBuyerOrg(resource.data.buyerOrganizationId)
      );
      allow write: if isStaff();
    }

    // =========================================================================
    // INSPECTIONS & QUALITY REPORTS
    // =========================================================================
    match /inspections/{inspectionId} {
      allow read: if isStaff() || (
        isBuyer() &&
        resource.data.published == true &&
        belongsToBuyerOrg(resource.data.buyerOrganizationId)
      );
      allow write: if isStaff();
    }

    // =========================================================================
    // LAB TEST REPORTS
    // =========================================================================
    match /labReports/{reportId} {
      allow read: if isStaff() || (
        isBuyer() &&
        resource.data.published == true &&
        resource.data.visibility == 'buyer' &&
        belongsToBuyerOrg(resource.data.buyerOrganizationId)
      );
      allow write: if isStaff();
    }

    // =========================================================================
    // SHIPMENTS & LOGISTICS
    // =========================================================================
    match /shipments/{shipmentId} {
      allow read: if isStaff() || belongsToBuyerOrg(resource.data.buyerOrganizationId);
      allow create, delete: if isStaff();
      allow update: if isStaff() || (
        isBuyer() &&
        belongsToBuyerOrg(resource.data.buyerOrganizationId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryConfirmation', 'updatedAt'])
      );

      match /packingItems/{itemId} {
        allow read: if isStaff() || belongsToBuyerOrg(get(/databases/$(database)/documents/shipments/$(shipmentId)).data.buyerOrganizationId);
        allow write: if isStaff();
      }

      match /events/{eventId} {
        allow read: if isStaff() || belongsToBuyerOrg(get(/databases/$(database)/documents/shipments/$(shipmentId)).data.buyerOrganizationId);
        allow write: if isStaff();
      }

      match /documentChecklist/{docId} {
        allow read: if isStaff() || belongsToBuyerOrg(get(/databases/$(database)/documents/shipments/$(shipmentId)).data.buyerOrganizationId);
        allow write: if isStaff();
      }
    }

    // =========================================================================
    // NOTIFICATIONS & COMMUNICATION
    // Recipient user can read and update 'read'/'isRead' status.
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.recipientUserId == request.auth.uid || isStaff());
      allow update: if isAuthenticated() && resource.data.recipientUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'isRead', 'readAt']);
      allow create, delete: if isStaff();
    }

    match /notificationPreferences/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isStaff());
    }

    match /notificationEvents/{eventId} {
      allow read, write: if isStaff();
    }

    match /emailDeliveryLogs/{deliveryId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // =========================================================================
    // PUBLIC INQUIRIES & CONTACT
    // =========================================================================
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // =========================================================================
    // AUDIT LOGS
    // Append-only, readable only by Super Admin.
    // =========================================================================
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false; // Cloud Functions / Admin SDK only in production
    }

    // =========================================================================
    // REPORTING & ANALYTICS SNAPSHOTS
    // =========================================================================
    match /reportSnapshots/{snapshotId} {
      allow read: if isStaff() || belongsToBuyerOrg(resource.data.buyerOrganizationId);
      allow create, update, delete: if isStaff();
    }

    match /reportConfigurations/{configId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin() || isAdmin();
    }

    // =========================================================================
    // SYSTEM SETTINGS
    // =========================================================================
    match /settings/{settingId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }
  }
}

