# ==============================================================================
# XYZ Buying House — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any real secrets to version control.
# ==============================================================================

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Firebase Public Web Configuration (Client SDK)
# ------------------------------------------------------------------------------
# In local development without Firebase keys, the application will run in
# mock/development mode gracefully without crashing.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase App Check (Production)
NEXT_PUBLIC_FIREBASE_APP_CHECK_KEY=

# ------------------------------------------------------------------------------
# Firebase Admin SDK (Server-Side Only - Never expose to client)
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# Email Service Provider (Resend / SMTP - Server-Side Only)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
SENDER_EMAIL=notifications@xyzbuyinghouse.com

# ------------------------------------------------------------------------------
# Error Monitoring & Analytics (Sentry / Analytics)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
